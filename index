<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ONPRI POS · Powered by AstinTech</title>
  <meta name="description" content="ONPRI POS, Powered by AstinTech — bilingual Kiswahili & English Point of Sale." />
  <link rel="canonical" href="https://onpri.duckdns.org/" />
  <style>
    :root {
      --bg: #f1f5f9;
      --surface: #ffffff;
      --surface-2: #f8fafc;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --accent: #2563eb;
      --accent-hover: #1d4ed8;
      --ok: #059669;
      --warn: #d97706;
      --danger: #dc2626;
    }
    html.dark {
      --bg: #020617;
      --surface: #0f172a;
      --surface-2: #1e293b;
      --text: #f8fafc;
      --muted: #94a3b8;
      --border: #1e293b;
      --accent: #3b82f6;
      --accent-hover: #2563eb;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.45;
    }
    .app-header {
      position: sticky; top: 0; z-index: 30;
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
      padding: 12px 20px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
    }
    .brand { display: flex; align-items: center; gap: 10px; }
    .brand-mark {
      width: 38px; height: 38px; border-radius: 10px;
      background: var(--accent); color: #fff;
      display: grid; place-items: center; font-weight: 800; font-size: 16px;
    }
    .brand h1 { margin: 0; font-size: 16px; font-weight: 800; }
    .brand p { margin: 0; font-size: 11px; color: var(--muted); }
    .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .btn {
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      padding: 7px 12px;
      border-radius: 9px;
      font-size: 12px; font-weight: 600;
      cursor: pointer;
    }
    .btn:hover { background: var(--surface-2); }
    .btn-primary {
      background: var(--accent); color: #fff; border-color: var(--accent);
    }
    .btn-primary:hover { background: var(--accent-hover); }
    .btn-ok { background: var(--ok); color: #fff; border-color: var(--ok); }
    .btn-danger { background: var(--danger); color: #fff; border-color: var(--danger); }
    .nav-tabs {
      display: flex; flex-wrap: wrap; gap: 8px;
      padding: 12px 20px 0;
      max-width: 1360px; margin: 0 auto;
    }
    .tab {
      padding: 8px 14px; border-radius: 10px; border: 1px solid var(--border);
      background: var(--surface); color: var(--muted); font-size: 13px; font-weight: 600; cursor: pointer;
    }
    .tab.active { background: var(--accent); color: #fff; border-color: var(--accent); }
    .container { max-width: 1360px; margin: 0 auto; padding: 16px 20px 40px; }
    .pos-grid { display: grid; grid-template-columns: 1fr 380px; gap: 18px; align-items: start; }
    @media (max-width: 960px) { .pos-grid { grid-template-columns: 1fr; } }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px;
    }
    .controls-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
    input, select {
      background: var(--surface-2); color: var(--text);
      border: 1px solid var(--border); border-radius: 9px;
      padding: 8px 11px; font-size: 13px;
    }
    .products-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(175px, 1fr)); gap: 10px;
    }
    .product-card {
      border: 1px solid var(--border);
      background: var(--surface-2);
      border-radius: 12px;
      padding: 12px;
      text-align: left;
      cursor: pointer;
      display: flex; flex-direction: column; justify-content: space-between; gap: 6px;
    }
    .product-card:hover { border-color: var(--accent); }
    .product-name { font-weight: 700; font-size: 13px; color: var(--text); }
    .product-meta { font-size: 11px; color: var(--muted); }
    .product-price { font-weight: 800; font-size: 14px; color: var(--accent); }
    .cart-list { display: flex; flex-direction: column; gap: 8px; max-height: 290px; overflow-y: auto; margin: 10px 0; }
    .cart-item {
      display: flex; justify-content: space-between; align-items: center; gap: 8px;
      padding: 8px 10px; border-radius: 10px; border: 1px solid var(--border); background: var(--surface-2);
    }
    .qty-controls { display: flex; align-items: center; gap: 6px; }
    .qty-btn {
      width: 26px; height: 26px; border-radius: 7px; border: 1px solid var(--border);
      background: var(--surface); color: var(--text); font-weight: 700; cursor: pointer;
    }
    .summary-row { display: flex; justify-content: space-between; font-size: 13px; margin: 5px 0; }
    .summary-total { font-size: 17px; font-weight: 800; border-top: 1px dashed var(--border); padding-top: 8px; margin-top: 8px; }
    .banner {
      padding: 10px 14px; border-radius: 10px; font-size: 12px; margin-bottom: 12px;
      border: 1px solid var(--border); background: var(--surface);
    }
    .banner.ok { border-color: #10b981; color: #047857; background: #ecfdf5; }
    .banner.err { border-color: #ef4444; color: #b91c1c; background: #fef2f2; }
    html.dark .banner.ok { background: #064e3b; color: #a7f3d0; }
    html.dark .banner.err { background: #7f1d1d; color: #fecaca; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .stat-label { font-size: 12px; color: var(--muted); }
    .stat-value { font-size: 22px; font-weight: 800; margin-top: 4px; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--border); }
    th { font-size: 11px; text-transform: uppercase; color: var(--muted); }
    .modal-backdrop {
      position: fixed; inset: 0; background: rgba(2, 6, 23, 0.65);
      display: none; align-items: center; justify-content: center; padding: 16px; z-index: 60;
    }
    .modal-backdrop.open { display: flex; }
    .modal {
      width: 100%; max-width: 440px;
      background: var(--surface); color: var(--text);
      border: 1px solid var(--border); border-radius: 16px; padding: 18px;
    }
    .receipt-paper {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      background: #fff; color: #111; padding: 16px; border-radius: 8px; border: 1px solid #cbd5e1;
    }
    .hidden { display: none !important; }
    @media print {
      body * { visibility: hidden; }
      #receiptPrintArea, #receiptPrintArea * { visibility: visible; }
      #receiptPrintArea { position: fixed; left: 0; top: 0; width: 80mm; border: none; }
    }
  </style>
</head>
<body>
  <header class="app-header">
    <div class="brand">
      <div class="brand-mark">OP</div>
      <div>
        <h1>ONPRI POS</h1>
        <p id="subtitleText">Powered by AstinTech · onpri.duckdns.org · Helpline: +254707857245</p>
      </div>
    </div>
    <div class="toolbar">
      <button class="btn" id="btnCloudAuth">Connect Cloud DB</button>
      <button class="btn" id="btnSyncCloud" disabled>Sync to Firestore</button>
      <button class="btn" id="btnBeepToggle">Sound: ON</button>
      <button class="btn" id="btnLangToggle">SW / EN</button>
      <button class="btn" id="btnThemeToggle">Dark</button>
    </div>
  </header>

  <nav class="nav-tabs">
    <button class="tab active" data-tab="pos" id="tabPos">POS Counter</button>
    <button class="tab" data-tab="inventory" id="tabInv">Inventory</button>
    <button class="tab" data-tab="sales" id="tabSales">Sales &amp; Reports</button>
    <button class="tab" data-tab="about" id="tabAbout">About POS</button>
  </nav>

  <main class="container">
    <div id="statusBanner" class="banner hidden"></div>

    <!-- POS COUNTER -->
    <section id="view-pos" class="pos-grid">
      <div class="card">
        <div class="controls-row">
          <input type="text" id="searchInput" placeholder="Search item name or SKU..." style="flex:1; min-width: 180px;" />
          <select id="categoryFilter">
            <option value="all">All Categories</option>
            <option value="beverages">Beverages</option>
            <option value="kitchen">Kitchen</option>
            <option value="retail">Retail</option>
            <option value="hospitality">Hospitality</option>
          </select>
          <button class="btn" id="btnOpenCamera">Scan Barcode</button>
        </div>
        <div id="productsGrid" class="products-grid"></div>
      </div>

      <aside class="card">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <h2 style="margin:0; font-size:15px;" id="cartTitle">Current Order</h2>
          <button class="btn" id="btnClearCart">Clear</button>
        </div>
        <div id="cartList" class="cart-list"></div>
        <div class="controls-row" style="margin-top:8px;">
          <select id="paymentMethod" style="flex:1;">
            <option value="Cash">Cash</option>
            <option value="M-Pesa">M-Pesa</option>
            <option value="Card">Card</option>
          </select>
          <input type="number" id="discountInput" min="0" value="0" placeholder="Discount" style="width:110px;" />
        </div>
        <div class="summary-row"><span id="lblSubtotal">Subtotal</span><strong id="valSubtotal">KES 0.00</strong></div>
        <div class="summary-row"><span id="lblVat">VAT (16% incl.)</span><strong id="valVat">KES 0.00</strong></div>
        <div class="summary-row"><span id="lblDiscount">Discount</span><strong id="valDiscount">KES 0.00</strong></div>
        <div class="summary-row summary-total"><span id="lblTotal">Total</span><strong id="valTotal">KES 0.00</strong></div>
        <button class="btn btn-primary" id="btnCheckout" style="width:100%; margin-top:12px; padding:11px; font-size:14px;">
          Complete Sale &amp; Print Receipt
        </button>
      </aside>
    </section>

    <!-- INVENTORY -->
    <section id="view-inventory" class="hidden">
      <div class="card" style="margin-bottom:14px;">
        <h2 style="margin:0 0 10px; font-size:15px;">Add / Restock Product</h2>
        <form id="addItemForm" class="controls-row" style="margin-bottom:0;">
          <input id="newSku" placeholder="SKU (e.g. COF-01)" required style="width:130px;" />
          <input id="newName" placeholder="Product name" required style="flex:1; min-width:170px;" />
          <select id="newCategory">
            <option value="beverages">Beverages</option>
            <option value="kitchen">Kitchen</option>
            <option value="retail">Retail</option>
            <option value="hospitality">Hospitality</option>
          </select>
          <input id="newPrice" type="number" min="0" step="0.01" placeholder="Price (KES)" required style="width:120px;" />
          <input id="newStock" type="number" min="0" placeholder="Qty" required style="width:90px;" />
          <button type="submit" class="btn btn-primary">Save Item</button>
        </form>
      </div>
      <div class="card" style="overflow-x:auto;">
        <table>
          <thead>
            <tr><th>SKU</th><th>Item</th><th>Category</th><th>Price</th><th>Stock</th><th>Action</th></tr>
          </thead>
          <tbody id="inventoryTableBody"></tbody>
        </table>
      </div>
    </section>

    <!-- SALES & REPORTS -->
    <section id="view-sales" class="hidden">
      <div class="stats-grid">
        <div class="card"><div class="stat-label">Total Revenue</div><div class="stat-value" id="statRevenue">KES 0.00</div></div>
        <div class="card"><div class="stat-label">Completed Sales</div><div class="stat-value" id="statOrders">0</div></div>
        <div class="card"><div class="stat-label">Inventory SKUs</div><div class="stat-value" id="statSkus">0</div></div>
        <div class="card"><div class="stat-label">Low Stock Alerts (&le; 5)</div><div class="stat-value" id="statLowStock">0</div></div>
      </div>
      <div class="card" style="overflow-x:auto;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
          <h2 style="margin:0; font-size:15px;">Recent Receipts</h2>
          <button class="btn" id="btnExportCsv">Export CSV</button>
        </div>
        <table>
          <thead>
            <tr><th>Receipt #</th><th>Time</th><th>Items</th><th>Method</th><th>Total</th><th>Receipt</th></tr>
          </thead>
          <tbody id="salesTableBody"></tbody>
        </table>
      </div>
