    <!-- ABOUT POS -->
    <section id="view-about" class="hidden">
      <div class="card">
        <h2 style="margin-top:0;">About ONPRI POS</h2>
        <p style="font-size:13px; color:var(--muted);">
          ONPRI POS, Powered by AstinTech — Bilingual English &amp; Kiswahili retail &amp; hospitality POS.
        </p>
        <p style="font-size:13px;"><strong>Domain:</strong> <a href="https://onpri.duckdns.org" target="_blank" rel="noreferrer">https://onpri.duckdns.org</a></p>
        <p style="font-size:13px;"><strong>Support Helpline:</strong> <a href="tel:+254707857245">+254707857245</a></p>
        <p style="font-size:13px;"><strong>Cloud Database:</strong> <code>valued-expanse-90z9n / ai-studio-onpripos-efed4a61-762a-4540-9c2e-8942d5520315</code></p>
      </div>
    </section>
  </main>

  <!-- RECEIPT MODAL -->
  <div class="modal-backdrop" id="receiptModal">
    <div class="modal">
      <div id="receiptPrintArea" class="receipt-paper"></div>
      <div style="display:flex; gap:8px; margin-top:12px; justify-content:flex-end;">
        <button class="btn" id="btnCloseReceipt">Close</button>
        <button class="btn btn-primary" onclick="window.print()">Print</button>
      </div>
    </div>
  </div>

  <!-- CAMERA BARCODE MODAL -->
  <div class="modal-backdrop" id="cameraModal">
    <div class="modal">
      <h3 style="margin-top:0; font-size:15px;">Camera SKU / Barcode Scanner</h3>
      <video id="cameraVideo" autoplay playsinline style="width:100%; border-radius:10px; background:#000;"></video>
      <p id="cameraStatus" style="font-size:12px; color:var(--muted); margin:8px 0;">Point camera at product barcode...</p>
      <div style="display:flex; justify-content:flex-end; gap:8px;">
        <button class="btn" id="btnCloseCamera">Close Camera</button>
      </div>
    </div>
  </div>

  <script type="module">
    import { initializeApp } from 'https://www.gstatic.com/firebasejs/11.6.0/firebase-app.js';
    import { getAuth, GoogleAuthProvider, onAuthStateChanged, signInWithPopup, signOut } from 'https://www.gstatic.com/firebasejs/11.6.0/firebase-auth.js';
    import { doc, getDoc, getDocFromServer, getFirestore, serverTimestamp, setDoc, updateDoc } from 'https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js';

    const firebaseConfig = {
      projectId: 'valued-expanse-90z9n',
      appId: '1:775243164588:web:690996bc6a4329beb66809',
      apiKey: 'AIzaSyA1IZ3AUsv26I9PYC2fsLTy1E7lKxLtYew',
      authDomain: 'valued-expanse-90z9n.firebaseapp.com',
      firestoreDatabaseId: 'ai-studio-onpripos-efed4a61-762a-4540-9c2e-8942d5520315',
      storageBucket: 'valued-expanse-90z9n.firebasestorage.app',
      messagingSenderId: '775243164588'
    };

    const fbApp = initializeApp(firebaseConfig);
    const db = getFirestore(fbApp, firebaseConfig.firestoreDatabaseId);
    const auth = getAuth(fbApp);
    const provider = new GoogleAuthProvider();
    provider.setCustomParameters({ prompt: 'select_account' });

    function handleFirestoreError(error, operationType, path) {
      const info = {
        error: error instanceof Error ? error.message : String(error),
        operationType,
        path,
        authInfo: {
          userId: auth.currentUser?.uid || null,
          email: auth.currentUser?.email || null,
          emailVerified: auth.currentUser?.emailVerified || null
        }
      };
      console.error('Firestore Error:', JSON.stringify(info));
      throw new Error(JSON.stringify(info));
    }

    (async function testConnection() {
      try {
        await getDocFromServer(doc(db, 'test', 'connection'));
      } catch (err) {
        if (err instanceof Error && err.message.includes('the client is offline')) {
          console.error('Please check your Firebase configuration.');
        }
      }
    })();

    const STORAGE_INV = 'onpri_html_inventory_v1';
    const STORAGE_SALES = 'onpri_html_sales_v1';

    const defaultInventory = [
      { id: '1', sku: 'BEV-001', name: 'Kenyan AA Coffee', nameSw: 'Kahawa ya Kenya AA', category: 'beverages', price: 320, stock: 45 },
      { id: '2', sku: 'KIT-002', name: 'Nyama Choma Platter', nameSw: 'Sahani ya Nyama Choma', category: 'kitchen', price: 1450, stock: 18 },
      { id: '3', sku: 'KIT-003', name: 'Chapati & Beef Stew', nameSw: 'Chapati na Mchuzi wa Nyama', category: 'kitchen', price: 550, stock: 24 },
      { id: '4', sku: 'BEV-004', name: 'Fresh Mango Juice', nameSw: 'Juisi ya Embe Halisi', category: 'beverages', price: 280, stock: 30 },
      { id: '5', sku: 'RET-005', name: 'Bottled Water 500ml', nameSw: 'Maji ya Chupa 500ml', category: 'retail', price: 100, stock: 80 },
      { id: '6', sku: 'HOS-006', name: 'Garden Day Pass', nameSw: 'Tiketi ya Bustani', category: 'hospitality', price: 500, stock: 50 }
    ];

    let inventory = JSON.parse(localStorage.getItem(STORAGE_INV) || 'null') || defaultInventory;
    let sales = JSON.parse(localStorage.getItem(STORAGE_SALES) || '[]');
    let cart = [];
    let lang = 'en';
    let beepOn = true;
    let audioCtx = null;
    let camStream = null;
    let camTimer = null;
    let cloudUser = null;

    const I18N = {
      en: {
        pos: 'POS Counter', inv: 'Inventory', sales: 'Sales & Reports', about: 'About POS',
        cart: 'Current Order', clear: 'Clear', checkout: 'Complete Sale & Print Receipt',
        subtotal: 'Subtotal', vat: 'VAT (16% incl.)', discount: 'Discount', total: 'Total'
      },
      sw: {
        pos: 'Kaunta ya Mauzo', inv: 'Bohari', sales: 'Mauzo na Ripoti', about: 'Kuhusu POS',
        cart: 'Oda ya Sasa', clear: 'Futa', checkout: 'Kamilisha Mauzo & Chapa Risiti',
        subtotal: 'Jumla Ndogo', vat: 'VAT (16% ndani)', discount: 'Punguzo', total: 'Jumla Kuu'
      }
    };

    function money(n) { return 'KES ' + Number(n || 0).toLocaleString('en-KE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
    function saveLocal() {
      localStorage.setItem(STORAGE_INV, JSON.stringify(inventory));
      localStorage.setItem(STORAGE_SALES, JSON.stringify(sales));
    }

    function beep(freq = 1200, dur = 0.07) {
      if (!beepOn) return;
      try {
        audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(); osc.stop(audioCtx.currentTime + dur);
      } catch {}
    }

    function showBanner(msg, type = 'ok') {
      const el = document.getElementById('statusBanner');
      el.textContent = msg;
      el.className = 'banner ' + type;
      setTimeout(() => el.classList.add('hidden'), 4500);
    }

    function renderProducts() {
      const q = document.getElementById('searchInput').value.trim().toLowerCase();
      const cat = document.getElementById('categoryFilter').value;
      const grid = document.getElementById('productsGrid');
      const list = inventory.filter(i =>
        (cat === 'all' || i.category === cat) &&
        (!q || i.name.toLowerCase().includes(q) || i.sku.toLowerCase().includes(q))
      );
      grid.innerHTML = list.map(item => `
        <button class="product-card" data-id="${item.id}" ${item.stock <= 0 ? 'disabled style="opacity:.5"' : ''}>
          <div>
            <div class="product-name">${lang === 'sw' && item.nameSw ? item.nameSw : item.name}</div>
            <div class="product-meta">${item.sku} · Stock: ${item.stock}</div>
          </div>
          <div class="product-price">${money(item.price)}</div>
        </button>
      `).join('');
      grid.querySelectorAll('.product-card').forEach(btn => {
        btn.addEventListener('click', () => addToCart(btn.dataset.id));
      });
    }

    function addToCart(id) {
      const item = inventory.find(i => i.id === id);
      if (!item || item.stock <= 0) return;
      const existing = cart.find(c => c.id === id);
      if (existing) {
        if (existing.qty >= item.stock) { beep(340, 0.12); return showBanner('Insufficient stock.', 'err'); }
        existing.qty += 1;
      } else {
        cart.push({ id: item.id, name: item.name, price: item.price, qty: 1 });
      }
      beep(1250, 0.06);
      renderCart();
    }

    function renderCart() {
      const list = document.getElementById('cartList');
      if (!cart.length) {
        list.innerHTML = `<p style="font-size:12px; color:var(--muted); margin:14px 0;">No items added yet.</p>`;
      } else {
        list.innerHTML = cart.map(c => `
          <div class="cart-item">
            <div style="min-width:0;">
              <div style="font-size:13px; font-weight:700;">${c.name}</div>
              <div style="font-size:11px; color:var(--muted);">${money(c.price)} x ${c.qty}</div>
            </div>
            <div class="qty-controls">
              <button class="qty-btn" data-act="dec" data-id="${c.id}">-</button>
              <strong style="font-size:13px;">${c.qty}</strong>
              <button class="qty-btn" data-act="inc" data-id="${c.id}">+</button>
            </div>
          </div>
        `).join('');
        list.querySelectorAll('.qty-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = cart.findIndex(x => x.id === btn.dataset.id);
            if (idx < 0) return;
            if (btn.dataset.act === 'inc') {
              const stockItem = inventory.find(i => i.id === btn.dataset.id);
              if (stockItem && cart[idx].qty < stockItem.stock) cart[idx].qty += 1;
            } else {
              cart[idx].qty -= 1;
              if (cart[idx].qty <= 0) cart.splice(idx, 1);
            }
            beep(980, 0.04);
            renderCart();
          });
        });
      }
      const subtotal = cart.reduce((s, c) => s + c.price * c.qty, 0);
      const discount = Math.min(subtotal, Math.max(0, Number(document.getElementById('discountInput').value || 0)));
      const total = Math.max(0, subtotal - discount);
      const vat = total - total / 1.16;
      document.getElementById('valSubtotal').textContent = money(subtotal);
      document.getElementById('valDiscount').textContent = money(discount);
      document.getElementById('valVat').textContent = money(vat);
      document.getElementById('valTotal').textContent = money(total);
    }

    function openReceipt(sale) {
      const area = document.getElementById('receiptPrintArea');
      area.innerHTML = `
        <div style="text-align:center; border-bottom:1px dashed #94a3b8; padding-bottom:8px; margin-bottom:8px;">
          <strong style="font-size:15px;">ONPRI POS</strong><br/>
          <span>Powered by AstinTech</span><br/>
          <span>onpri.duckdns.org · +254707857245</span><br/>
          <span>Receipt: ${sale.receiptNo}</span><br/>
          <span>${new Date(sale.createdAt).toLocaleString()}</span>
        </div>
        ${sale.items.map(i => `<div style="display:flex; justify-content:space-between;"><span>${i.qty}x ${i.name}</span><span>${money(i.price * i.qty)}</span></div>`).join('')}
        <div style="border-top:1px dashed #94a3b8; margin-top:8px; padding-top:8px;">
          <div style="display:flex; justify-content:space-between;"><span>Payment</span><strong>${sale.method}</strong></div>
          <div style="display:flex; justify-content:space-between;"><span>VAT (16%)</span><span>${money(sale.vat)}</span></div>
          <div style="display:flex; justify-content:space-between; font-size:14px;"><strong>TOTAL</strong><strong>${money(sale.total)}</strong></div>
        </div>
        <div style="text-align:center; margin-top:10px;">Asante! Thank you for choosing ONPRI POS.</div>
      `;
      document.getElementById('receiptModal').classList.add('open');
    }

    function renderInventoryAndSales() {
      document.getElementById('inventoryTableBody').innerHTML = inventory.map(i => `
        <tr>
          <td><code>${i.sku}</code></td>
          <td><strong>${i.name}</strong></td>
          <td>${i.category}</td>
          <td>${money(i.price)}</td>
          <td>${i.stock}</td>
          <td><button class="btn" data-restock="${i.id}">+5 Stock</button></td>
        </tr>
      `).join('');
      document.querySelectorAll('[data-restock]').forEach(btn => {
        btn.addEventListener('click', () => {
          const item = inventory.find(x => x.id === btn.dataset.restock);
          if (item) { item.stock += 5; saveLocal(); renderProducts(); renderInventoryAndSales(); beep(1100, 0.05); }
        });
      });

      const rev = sales.reduce((s, r) => s + r.total, 0);
      document.getElementById('statRevenue').textContent = money(rev);
      document.getElementById('statOrders').textContent = String(sales.length);
      document.getElementById('statSkus').textContent = String(inventory.length);
      document.getElementById('statLowStock').textContent = String(inventory.filter(i => i.stock <= 5).length);

      document.getElementById('salesTableBody').innerHTML = sales.map(s => `
        <tr>
          <td><strong>${s.receiptNo}</strong></td>
          <td>${new Date(s.createdAt).toLocaleString()}</td>
          <td>${s.items.reduce((a, b) => a + b.qty, 0)}</td>
          <td>${s.method}</td>
          <td><strong>${money(s.total)}</strong></td>
          <td><button class="btn" data-view-receipt="${s.id}">View</button></td>
        </tr>
      `).join('');
      document.querySelectorAll('[data-view-receipt]').forEach(btn => {
        btn.addEventListener('click', () => {
          const found = sales.find(x => x.id === btn.dataset.viewReceipt);
          if (found) openReceipt(found);
        });
      });
    }

    // Events
    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        ['pos', 'inventory', 'sales', 'about'].forEach(v => {
          document.getElementById('view-' + v).classList.toggle('hidden', v !== tab.dataset.tab);
        });
      });
    });

    document.getElementById('searchInput').addEventListener('input', renderProducts);
    document.getElementById('categoryFilter').addEventListener('change', renderProducts);
    document.getElementById('discountInput').addEventListener('input', renderCart);
    document.getElementById('btnClearCart').addEventListener('click', () => { cart = []; renderCart(); });
    document.getElementById('btnCloseReceipt').addEventListener('click', () => document.getElementById('receiptModal').classList.remove('open'));

    document.getElementById('btnCheckout').addEventListener('click', () => {
      if (!cart.length) { beep(340, 0.1); return showBanner('Add at least one item before checkout.', 'err'); }
      const subtotal = cart.reduce((s, c) => s + c.price * c.qty, 0);
      const discount = Math.min(subtotal, Math.max(0, Number(document.getElementById('discountInput').value || 0)));
      const total = Math.max(0, subtotal - discount);
      const sale = {
        id: 'sale_' + Date.now(),
        receiptNo: 'ONP-' + String(sales.length + 1001),
        items: cart.map(c => ({ ...c })),
        method: document.getElementById('paymentMethod').value,
        discount,
        vat: total - total / 1.16,
        total,
        createdAt: new Date().toISOString()
      };
      cart.forEach(c => {
        const inv = inventory.find(i => i.id === c.id);
        if (inv) inv.stock = Math.max(0, inv.stock - c.qty);
      });
      sales.unshift(sale);
      cart = [];
      document.getElementById('discountInput').value = '0';
      saveLocal();
      renderProducts(); renderCart(); renderInventoryAndSales();
      beep(1560, 0.12);
      openReceipt(sale);
    });

    document.getElementById('addItemForm').addEventListener('submit', e => {
      e.preventDefault();
      inventory.unshift({
        id: 'sku_' + Date.now(),
        sku: document.getElementById('newSku').value.trim().toUpperCase(),
        name: document.getElementById('newName').value.trim(),
        nameSw: '',
        category: document.getElementById('newCategory').value,
        price: Number(document.getElementById('newPrice').value || 0),
        stock: Math.max(0, Math.floor(Number(document.getElementById('newStock').value || 0)))
      });
      e.target.reset();
      saveLocal();
      renderProducts(); renderInventoryAndSales();
      beep(1320, 0.08);
      showBanner('Product saved to inventory.');
    });

    document.getElementById('btnExportCsv').addEventListener('click', () => {
      const rows = [['Receipt', 'Date', 'Payment', 'Total'], ...sales.map(s => [s.receiptNo, s.createdAt, s.method, s.total])];
      const csv = rows.map(r => r.join(',')).join('\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
      a.download = 'onpri-sales.csv';
      a.click();
    });

    document.getElementById('btnBeepToggle').addEventListener('click', e => {
      beepOn = !beepOn;
      e.target.textContent = beepOn ? 'Sound: ON' : 'Sound: OFF';
    });

    document.getElementById('btnThemeToggle').addEventListener('click', e => {
      const dark = document.documentElement.classList.toggle('dark');
      e.target.textContent = dark ? 'Light' : 'Dark';
    });

    document.getElementById('btnLangToggle').addEventListener('click', () => {
      lang = lang === 'en' ? 'sw' : 'en';
      const t = I18N[lang];
      document.getElementById('tabPos').textContent = t.pos;
      document.getElementById('tabInv').textContent = t.inv;
      document.getElementById('tabSales').textContent = t.sales;
      document.getElementById('tabAbout').textContent = t.about;
      document.getElementById('cartTitle').textContent = t.cart;
      document.getElementById('btnClearCart').textContent = t.clear;
      document.getElementById('btnCheckout').textContent = t.checkout;
      document.getElementById('lblSubtotal').textContent = t.subtotal;
      document.getElementById('lblVat').textContent = t.vat;
      document.getElementById('lblDiscount').textContent = t.discount;
      document.getElementById('lblTotal').textContent = t.total;
      renderProducts();
    });

    // Camera SKU Scanner
    async function stopCamera() {
      if (camTimer) clearInterval(camTimer);
      if (camStream) camStream.getTracks().forEach(t => t.stop());
      camStream = null;
      document.getElementById('cameraModal').classList.remove('open');
    }
    document.getElementById('btnCloseCamera').addEventListener('click', stopCamera);
    document.getElementById('btnOpenCamera').addEventListener('click', async () => {
      document.getElementById('cameraModal').classList.add('open');
      try {
        camStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
        const video = document.getElementById('cameraVideo');
        video.srcObject = camStream;
        if ('BarcodeDetector' in window) {
          const detector = new window.BarcodeDetector();
          camTimer = setInterval(async () => {
            try {
              const codes = await detector.detect(video);
              if (codes.length) {
                const raw = (codes[0].rawValue || '').trim().toLowerCase();
                const match = inventory.find(i => i.sku.toLowerCase() === raw);
                if (match) { addToCart(match.id); stopCamera(); showBanner('Scanned: ' + match.name); }
              }
            } catch {}
          }, 500);
        } else {
          document.getElementById('cameraStatus').textContent = 'Camera active. BarcodeDetector not supported in this browser; search SKU manually.';
        }
      } catch {
        document.getElementById('cameraStatus').textContent = 'Camera access denied or unavailable.';
      }
    });

    // Firebase Cloud Auth & Firestore Sync
    onAuthStateChanged(auth, user => {
      cloudUser = user;
      document.getElementById('btnCloudAuth').textContent = user ? 'Disconnect (' + (user.email || 'Cloud') + ')' : 'Connect Cloud DB';
      document.getElementById('btnSyncCloud').disabled = !user;
    });

    document.getElementById('btnCloudAuth').addEventListener('click', async () => {
      try {
        if (cloudUser) { await signOut(auth); showBanner('Disconnected from Cloud Firestore.'); }
        else { await signInWithPopup(auth, provider); beep(1350, 0.08); showBanner('Connected to Cloud Firestore.'); }
      } catch (err) {
        showBanner(err instanceof Error ? err.message : 'Google Sign-In failed.', 'err');
      }
    });

    document.getElementById('btnSyncCloud').addEventListener('click', async () => {
      if (!cloudUser) return;
      const uid = cloudUser.uid.replace(/[^a-zA-Z0-9_-]/g, '_').slice(0, 128);
      const wsId = ('ws_html_' + uid.slice(0, 16)).replace(/[^a-zA-Z0-9_-]/g, '_');
      const wsPath = `workspaces/${wsId}`;
      try {
        const wsRef = doc(db, 'workspaces', wsId);
        const wsSnap = await getDoc(wsRef);
        if (wsSnap.exists()) {
          await updateDoc(wsRef, { name: 'ONPRI POS Web', currency: 'KES', domain: 'onpri.duckdns.org', updatedAt: serverTimestamp() });
        } else {
          await setDoc(wsRef, {
            id: wsId, ownerId: uid, tenantId: 'onpri_web',
            name: 'ONPRI POS Web', currency: 'KES', domain: 'onpri.duckdns.org',
            createdAt: serverTimestamp(), updatedAt: serverTimestamp()
          });
        }
        const snapId = 'snap_' + Date.now();
        await setDoc(doc(db, 'workspaces', wsId, 'snapshots', snapId), {
          workspaceId: wsId, ownerId: uid, summaryLabel: 'ONPRI HTML POS Sync',
          totalSalesCount: sales.length,
          totalRevenue: Math.round(sales.reduce((s, r) => s + r.total, 0) * 100) / 100,
          inventoryCount: inventory.length,
          expensesCount: 0,
          gateLogsCount: 0,
          createdAt: serverTimestamp()
        });
        beep(1560, 0.1);
        showBanner('Synced snapshot to Cloud Firestore!');
      } catch (err) {
        handleFirestoreError(err, 'write', wsPath);
      }
    });

    renderProducts();
    renderCart();
    renderInventoryAndSales();
  </script>
</body>
</html>
